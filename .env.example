# Core runtime
TRADING_MODE=paper
AUTO_SUBMIT=false
OPERATION_MODE=manual
WORKER_PLAYBOOK=
WORKER_LOOP=true
WORKER_INTERVAL_SECONDS=300
WORKER_MIN_SLEEP_SECONDS=30
WORKER_MAX_CYCLES=0
WORKER_ENABLE_REFRESH=true
WORKER_ENFORCE_FRESHNESS=true

# Worker circulation behavior
AGGRESSIVE_CIRCULATION_ENABLED=true
AGGRESSIVE_CIRCULATION_LOOPS=2
AGGRESSIVE_CIRCULATION_PAUSE_SECONDS=5

# AI decision engine (phase 1 and phase 2)
AI_DECISION_ENGINE_ENABLED=false
AI_DECISION_ENGINE_MODEL=claude-sonnet-4-6
AI_DECISION_ENGINE_TIMEOUT_SECONDS=25
AI_DECISION_ENGINE_MAX_TOKENS=1000
AI_DECISION_ENGINE_ROUTE_ENABLED=false
AI_DECISION_ENGINE_MIN_CONFIDENCE=0.55
ANTHROPIC_API_KEY=

# Worker health thresholds
WORKER_HEALTH_MAX_AGE_SECONDS=1200

# Live routing and preflight
CONFIRM_LIVE_TRADING=false

# Auth gateway (optional secure profile)
STREAMLIT_ORIGIN=http://options-dashboard:8502
GATEWAY_EMAIL=you@example.com
GATEWAY_PASSWORD=
GATEWAY_SECRET_KEY=
SESSION_MAX_AGE=28800
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_DOMAIN=.simplestudiotrades.com

# Remote HTTPS proxy (mobile access via docker-compose.remote.yml)
DOMAIN=trade.simplestudiotrades.com
TLS_EMAIL=you@example.com

# Ops notifications
OPS_WEBHOOK_URL=

# Option-entry safety checks
MAX_INTRADAY_DRIFT_PCT=0.05
MAX_OPTION_SPREAD_PCT=0.06
MAX_SINGLE_LEG_IV_RANK=80.0
EARNINGS_BLACKOUT_DAYS=7
BREAKING_NEWS_COUNT_THRESHOLD=3
BREAKING_NEWS_MOVE_PCT=0.04
MAX_QUOTE_AGE_SECONDS=60
REQUIRE_STRICT_IV_RANK=true
OPTION_SAFETY_DB=outputs/options_safety.sqlite3
FINNHUB_API_KEY=

# Read-only options monitoring API authentication. Never use example values in production.
OPTIONS_API_EMAIL=
# Generate with: python options_api.py --hash-password
OPTIONS_API_PASSWORD_HASH=
# Set to a random secret of at least 32 bytes; keep it private and rotate deliberately.
OPTIONS_API_JWT_SECRET=
OPTIONS_API_ALLOWED_ORIGINS=https://trade.simplestudiotrades.com,http://127.0.0.1:8504,http://localhost:8504
OPTIONS_API_COOKIE_SECURE=true

# If strict IV rank is false and fewer than 20 IV observations exist, the
# fallback is the range rank of 20-day realized volatility over 252 observations.
# This proxy is not implied-volatility rank and does not measure IV crush.
# Run record_eod_iv.py SYMBOL... on trading days near 16:00 America/New_York.
# The recorder accepts 15:55-16:05 weekdays, requires fresh quotes, and stores
# a near-ATM call with 25-35 DTE in OPTION_SAFETY_DB; it is not scheduled automatically.
