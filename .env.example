# Core runtime
TRADING_MODE=paper
OPERATION_MODE=manual
WORKER_PLAYBOOK=
WORKER_LOOP=true
WORKER_INTERVAL_SECONDS=300
WORKER_MIN_SLEEP_SECONDS=30
WORKER_MAX_CYCLES=0
WORKER_ENABLE_REFRESH=true
WORKER_ENFORCE_FRESHNESS=true

# Worker circulation behavior
AGGRESSIVE_CIRCULATION_ENABLED=true
AGGRESSIVE_CIRCULATION_LOOPS=2
AGGRESSIVE_CIRCULATION_PAUSE_SECONDS=5

# AI decision engine (phase 1 and phase 2)
AI_DECISION_ENGINE_ENABLED=false
AI_DECISION_ENGINE_MODEL=claude-sonnet-4-6
AI_DECISION_ENGINE_TIMEOUT_SECONDS=25
AI_DECISION_ENGINE_MAX_TOKENS=1000
AI_DECISION_ENGINE_ROUTE_ENABLED=false
AI_DECISION_ENGINE_MIN_CONFIDENCE=0.55
ANTHROPIC_API_KEY=

# Worker health thresholds
WORKER_HEALTH_MAX_AGE_SECONDS=1200

# Live routing and preflight
CONFIRM_LIVE_TRADING=false

# Auth gateway (optional secure profile)
STREAMLIT_ORIGIN=http://options-dashboard:8502
GATEWAY_EMAIL=simplesstudiohub@gmail.com
GATEWAY_PASSWORD=MFSclassof2018
GATEWAY_SECRET_KEY=200020182022
SESSION_MAX_AGE=28800
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_DOMAIN=.simplestudiotrades.com

# Remote HTTPS proxy (mobile access via docker-compose.remote.yml)
DOMAIN=trade.simplestudiotrades.com
TLS_EMAIL=simplestudiohub@gmail.com

# Ops notifications
OPS_WEBHOOK_URL=
